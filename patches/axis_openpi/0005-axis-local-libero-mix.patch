+def _freeze_axis_pi05_lora(path: nnx.filterlib.PathParts, _param: Any) -> bool:
+    """Freeze AXIS Pi0.5 except the arm selected by AXIS_PI05_SCOPE."""
+    param_path = "/".join(str(part) for part in path)
+    scope = os.environ.get("AXIS_PI05_SCOPE", "F0").upper()
+    if "lora" in param_path.lower():
+        return False
+    if scope in {"F1", "F2"} and "action_" in param_path and "_proj" in param_path:
+        return False
+    if scope == "F2" and "time_mlp_" in param_path:
+        return False
+    return True
