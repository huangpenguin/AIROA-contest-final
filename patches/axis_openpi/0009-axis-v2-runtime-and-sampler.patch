+def _path_text(path: tuple[Any, ...]) -> str:
+    return "/".join(str(getattr(part, "key", getattr(part, "idx", part))) for part in path)
+
+
+def _group_norm(tree: Any, needle: str) -> jax.Array:
+    leaves = [
+        value
+        for path, value in jax.tree_util.tree_flatten_with_path(tree)[0]
+        if needle in _path_text(path).lower()
+    ]
+    return optax.global_norm(leaves) if leaves else jnp.asarray(0.0, dtype=jnp.float32)
+
+
+def _nonfinite_leaf_count(tree: Any) -> jax.Array:
+    leaves = [value for value in jax.tree_util.tree_leaves(tree) if hasattr(value, "dtype")]
+    return jnp.asarray(sum(jnp.any(~jnp.isfinite(value)) for value in leaves), dtype=jnp.int32)
+
+
+def _first_nonfinite_path(tree: Any) -> str | None:
+    for path, value in jax.tree_util.tree_flatten_with_path(tree)[0]:
+        if hasattr(value, "dtype") and not np.all(np.isfinite(np.asarray(value))):
+            return _path_text(path)
+    return None
+
