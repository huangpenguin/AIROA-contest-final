+def _jsonable(value: Any) -> Any:
+    if isinstance(value, dict):
+        return {str(key): _jsonable(item) for key, item in value.items()}
+    if isinstance(value, (tuple, list)):
+        return [_jsonable(item) for item in value]
+    if isinstance(value, np.ndarray):
+        return value.tolist()
+    if isinstance(value, np.generic):
+        return value.item()
+    return value
+
+
+def _key_fingerprint(key: at.KeyArrayLike) -> dict[str, Any]:
+    data = np.ascontiguousarray(np.asarray(jax.device_get(jax.random.key_data(key))))
+    return {
+        "dtype": str(data.dtype),
+        "shape": list(data.shape),
+        "sha256": hashlib.sha256(data.tobytes()).hexdigest(),
+        "values": data.tolist(),
+    }
+
+
+def _audit_rng_fixture(micro_rng: at.KeyArrayLike, action_shape: tuple[int, ...]) -> tuple[dict[str, Any], dict[str, Any]]:
+    """Reconstruct the model's time/noise draws for audit/replay only."""
+    preprocess_rng, noise_rng, time_rng = jax.random.split(micro_rng, 3)
+    del preprocess_rng
+    noise = jax.random.normal(noise_rng, action_shape)
+    time = jax.random.beta(time_rng, 1.5, 1, action_shape[:-2]) * 0.999 + 0.001
+    return (
+        {
+            "base": _key_fingerprint(micro_rng),
+            "noise": _key_fingerprint(noise_rng),
+            "time": _key_fingerprint(time_rng),
+            "noise_stats": _nan_replay.array_fingerprint(noise),
+            "time_stats": _nan_replay.array_fingerprint(time),
+        },
+        {"noise": np.asarray(noise), "time": np.asarray(time)},
+    )
+
+
+def _audit_metadata_rows(metadata: Any) -> list[dict[str, Any]]:
+    if metadata is None:
+        return []
+    if not isinstance(metadata, dict):
+        return [{"value": _jsonable(metadata)}]
+    sample_count = next(
+        (
+            int(np.asarray(value).shape[0])
+            for value in metadata.values()
+            if hasattr(value, "shape") and np.asarray(value).ndim > 0
+        ),
+        1,
+    )
+    rows = []
+    for index in range(sample_count):
+        row = {}
+        for key, value in metadata.items():
+            array = np.asarray(value)
+            row[str(key)] = _jsonable(array[index] if array.ndim > 0 and array.shape[0] == sample_count else value)
+        rows.append(row)
+    return rows
+
+
+def _append_audit_trace(path: Path, row: dict[str, Any]) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with path.open("a", encoding="utf-8") as handle:
+        handle.write(json.dumps(_jsonable(row), sort_keys=True) + "\n")
+
+
