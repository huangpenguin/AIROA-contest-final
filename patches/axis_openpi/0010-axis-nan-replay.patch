+        tensor_output_dir=audit.get("tensor_output_dir"),
+    )
+
+
+def _split_loaded_batch(loaded: Any) -> tuple[tuple[_model.Observation, _model.Actions], Any]:
+    if isinstance(loaded, tuple) and len(loaded) == 4 and isinstance(loaded[0], _model.Observation):
+        return (loaded[0], loaded[1]), {
+            "__rows__": loaded[2],
+            "__rng_overrides__": loaded[3],
+        }
+    if isinstance(loaded, tuple) and len(loaded) == 3 and isinstance(loaded[0], _model.Observation):
+        return (loaded[0], loaded[1]), loaded[2]
+    return loaded, None
