diff --git a/src/openpi/training/nan_replay.py b/src/openpi/training/nan_replay.py
new file mode 100644
index 0000000..96f1190
--- /dev/null
+++ b/src/openpi/training/nan_replay.py
@@ -0,0 +1,157 @@
+"""Small, dependency-light artifacts for reproducible NaN localization.
+
+The functions in this module operate on host-side copies of already transformed
+microbatches.  They intentionally do not alter the training pytree or the
+random-number implementation.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from collections.abc import Mapping
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+
+
+def array_fingerprint(value: Any) -> dict[str, Any]:
+    array = np.ascontiguousarray(np.asarray(value))
+    result: dict[str, Any] = {
+        "dtype": str(array.dtype),
+        "shape": list(array.shape),
+        "sha256": hashlib.sha256(array.tobytes()).hexdigest(),
+    }
+    if array.dtype.kind in "biufc" and array.size:
+        finite = np.isfinite(array)
+        result.update(
+            {
+                "finite": bool(finite.all()),
+                "finite_count": int(finite.sum()),
+                "nonfinite_count": int((~finite).sum()),
+                "min": float(np.min(array[finite])) if finite.any() else None,
+                "max": float(np.max(array[finite])) if finite.any() else None,
+                "mean": float(np.mean(array[finite])) if finite.any() else None,
+            }
+        )
+    return result
+
+
+def tree_fingerprints(tree: Any, prefix: str = "") -> dict[str, dict[str, Any]]:
+    if isinstance(tree, Mapping):
+        result: dict[str, dict[str, Any]] = {}
+        for key, value in tree.items():
+            path = f"{prefix}/{key}" if prefix else str(key)
+            result.update(tree_fingerprints(value, path))
+        return result
+    if isinstance(tree, (tuple, list)):
+        result = {}
+        for index, value in enumerate(tree):
+            path = f"{prefix}/{index}" if prefix else str(index)
+            result.update(tree_fingerprints(value, path))
+        return result
+    try:
+        return {prefix or "value": array_fingerprint(tree)}
+    except (TypeError, ValueError):
+        return {prefix or "value": {"repr": repr(tree)}}
+
+
+def _observation_tree(observation: Any) -> dict[str, Any]:
+    if hasattr(observation, "to_dict"):
+        return observation.to_dict()
+    if hasattr(observation, "__dict__"):
+        return dict(observation.__dict__)
+    return {"value": observation}
+
+
+def save_replay_bundle(
+    output_dir: str | Path,
+    *,
+    microbatches: list[tuple[Any, Any]],
+    metadata: list[Any],
+    rng_fixtures: list[dict[str, Any]] | None = None,
+    failure: dict[str, Any],
+    runtime: dict[str, Any],
+    tensor_output_dir: str | Path | None = None,
+) -> dict[str, Any]:
+    """Write a complete host-side replay bundle and return its manifest."""
+    output = Path(output_dir)
+    output.mkdir(parents=True, exist_ok=True)
+    tensor_output = Path(tensor_output_dir) if tensor_output_dir is not None else output
+    tensor_output.mkdir(parents=True, exist_ok=True)
+    tensors: dict[str, np.ndarray] = {}
+    arrays: dict[str, dict[str, Any]] = {}
+    for micro_index, (observation, actions) in enumerate(microbatches):
+        tree = {
+            "observation": _observation_tree(observation),
+            "actions": actions,
+        }
+
+        def collect(node: Any, path: str) -> None:
+            if isinstance(node, Mapping):
+                for key, value in node.items():
+                    collect(value, f"{path}/{key}" if path else str(key))
+                return
+            if isinstance(node, (tuple, list)):
+                for index, value in enumerate(node):
+                    collect(value, f"{path}/{index}" if path else str(index))
+                return
+            try:
+                array = np.asarray(node)
+            except (TypeError, ValueError):
+                return
+            if array.dtype.kind not in "biufcSU":
+                return
+            key = f"micro_{micro_index:03d}/{path}".replace("/", "__")
+            tensors[key] = np.ascontiguousarray(array)
+            arrays[key] = array_fingerprint(array)
+
+        collect(tree, "")
+        if rng_fixtures is not None and micro_index < len(rng_fixtures):
+            fixture = rng_fixtures[micro_index]
+            for fixture_name in ("noise", "time"):
+                if fixture_name not in fixture:
+                    continue
+                array = np.ascontiguousarray(np.asarray(fixture[fixture_name]))
+                key = f"micro_{micro_index:03d}/rng/{fixture_name}".replace("/", "__")
+                tensors[key] = array
+                arrays[key] = array_fingerprint(array)
+
+    replay_path = tensor_output / "replay_batch.npz"
+    np.savez_compressed(replay_path, **tensors)
+    manifest = {
+        "schema_version": 1,
+        "replay_batch": str(replay_path),
+        "replay_batch_sha256": hashlib.sha256(replay_path.read_bytes()).hexdigest(),
+        "arrays": arrays,
+        "microbatch_count": len(microbatches),
+        "metadata": metadata,
+        "failure": failure,
+        "runtime": runtime,
+    }
+    (output / "replay_manifest.json").write_text(
+        json.dumps(manifest, indent=2, sort_keys=True, default=_json_default) + "\n",
+        encoding="utf-8",
+    )
+    (output / "input_stats.json").write_text(
+        json.dumps({"schema_version": 1, "arrays": arrays}, indent=2, sort_keys=True) + "\n",
+        encoding="utf-8",
+    )
+    (output / "failure.json").write_text(
+        json.dumps(failure, indent=2, sort_keys=True, default=_json_default) + "\n",
+        encoding="utf-8",
+    )
+    (output / "environment.json").write_text(
+        json.dumps(runtime, indent=2, sort_keys=True, default=_json_default) + "\n",
+        encoding="utf-8",
+    )
+    return manifest
+
+
+def _json_default(value: Any) -> Any:
+    if isinstance(value, np.ndarray):
+        return value.tolist()
+    if isinstance(value, np.generic):
+        return value.item()
+    return str(value)
