+def train_step_accumulated(
+    config: _config.TrainConfig,
+    rng: at.KeyArrayLike,
+    state: training_utils.TrainState,
+    microbatches: tuple[tuple[_model.Observation, _model.Actions], ...],
+) -> tuple[training_utils.TrainState, dict[str, at.Array]]:
+    """Run many microbatch gradients followed by exactly one optimizer step."""
+    if not microbatches:
+        raise ValueError("gradient accumulation requires at least one microbatch")
+    if config.effective_global_batch is not None:
+        observed = microbatches[0][1].shape[0] * len(microbatches)
+        if config.effective_global_batch != observed:
+            raise ValueError(
+                "effective_global_batch does not match the supplied microbatches: "
+                f"{config.effective_global_batch} != {observed}"
+            )
+
+    base_rng = state.rng if state.rng is not None else rng
+    next_rng, step_rng = jax.random.split(base_rng)
+    grad_sum = None
+    total_loss_sum = jnp.asarray(0.0, dtype=jnp.float32)
+    total_valid = jnp.asarray(0, dtype=jnp.int32)
+    total_examples = jnp.asarray(0, dtype=jnp.int32)
+    total_seven = jnp.asarray(0.0, dtype=jnp.float32)
+    total_padded25 = jnp.asarray(0.0, dtype=jnp.float32)
+    total_temporal_pad = jnp.asarray(0.0, dtype=jnp.float32)
+    for micro_index, batch in enumerate(microbatches):
