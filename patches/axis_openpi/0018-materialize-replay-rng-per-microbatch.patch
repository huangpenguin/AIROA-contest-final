+class AxisOfficialLiberoDataset(torch.utils.data.Dataset):
+    """Read the pinned official LIBERO v2.0 snapshot without conversion.
+
+    The canonical ``physical-intelligence/libero`` release stores one parquet
+    per episode and keeps RGB frames inline as encoded image bytes. State and
+    action columns are read during construction; images are decoded only when
+    a sample is accessed. This keeps the full norm pass on the OpenPI loader
+    path without doing image I/O for every statistic update.
+    """
+
+    def __init__(
+        self,
+        root: str,
+        action_horizon: int,
+        episodes: Sequence[int] | None = None,
+        *,
+        v3_keys: bool = False,
+        decode_images: bool = True,
+    ):
+        import json
+        import pyarrow.parquet as pq
+
+        self.root = pathlib.Path(root)
+        self.action_horizon = int(action_horizon)
+        if self.action_horizon <= 0:
+            raise ValueError("action_horizon must be positive")
+        self.v3_keys = bool(v3_keys)
+        self.decode_images = bool(decode_images)
+        self.tasks: dict[int, str] = {}
+        with (self.root / "meta" / "tasks.jsonl").open(encoding="utf-8") as handle:
+            for line in handle:
+                if line.strip():
+                    item = json.loads(line)
+                    self.tasks[int(item["task_index"])] = str(item["task"])
+
+        selected = None if episodes is None else {int(value) for value in episodes}
+        files = sorted((self.root / "data").glob("chunk-*/episode_*.parquet"))
+        if not files:
+            raise FileNotFoundError(f"official LIBERO parquet files not found under {self.root / 'data'}")
+        self._episodes: dict[int, dict[str, Any]] = {}
+        for data_file in files:
+            match = re.match(r"episode_(\d+)\.parquet$", data_file.name)
+            if match is None:
+                raise ValueError(f"unexpected official episode filename: {data_file}")
+            episode = int(match.group(1))
+            if selected is not None and episode not in selected:
+                continue
+            table = pq.read_table(
+                data_file,
+                columns=["state", "actions", "timestamp", "frame_index", "episode_index", "index", "task_index"],
+            )
+            episode_values = np.asarray(table["episode_index"].to_numpy(zero_copy_only=False), dtype=np.int64)
+            if episode_values.size == 0 or not np.all(episode_values == episode):
+                raise ValueError(f"episode index mismatch in {data_file}")
+            states = np.asarray(table["state"].to_pylist(), dtype=np.float32)
+            actions = np.asarray(table["actions"].to_pylist(), dtype=np.float32)
+            timestamps = np.asarray(table["timestamp"].to_numpy(zero_copy_only=False), dtype=np.float64)
+            frames = np.asarray(table["frame_index"].to_numpy(zero_copy_only=False), dtype=np.int64)
+            indices = np.asarray(table["index"].to_numpy(zero_copy_only=False), dtype=np.int64)
+            task_values = np.asarray(table["task_index"].to_numpy(zero_copy_only=False), dtype=np.int64)
+            if states.ndim != 2 or states.shape[1] != 8:
+                raise ValueError(f"official state contract mismatch in {data_file}: {states.shape}")
+            if actions.ndim != 2 or actions.shape[1] != 7:
+                raise ValueError(f"official action contract mismatch in {data_file}: {actions.shape}")
+            if np.unique(task_values).size != 1:
+                raise ValueError(f"episode has multiple task indices: {data_file}")
+            task_index = int(task_values[0])
+            if task_index not in self.tasks:
+                raise ValueError(f"task index {task_index} missing from official task catalog")
+            if episode in self._episodes:
+                raise ValueError(f"duplicate official episode: {episode}")
+            self._episodes[episode] = {
+                "file": data_file,
+                "states": states,
+                "actions": actions,
+                "timestamps": timestamps,
+                "frames": frames,
+                "indices": indices,
+                "task_index": task_index,
+            }
+        if selected is not None:
+            missing = sorted(selected - set(self._episodes))
+            if missing:
+                raise ValueError(f"selected official episodes missing: {missing[:10]}")
+        self.episode_records = self._episodes
+        self._index = [
+            (episode, offset)
+            for episode in sorted(self._episodes)
+            for offset in range(len(self._episodes[episode]["states"]))
+        ]
+        self._image_tables: dict[str, Any] = {}
+
+    def __len__(self) -> int:
+        return len(self._index)
+
+    def _decode_image(self, table: Any, column: str, offset: int) -> np.ndarray:
+        import io
+        from PIL import Image
+
+        encoded = table[column][offset].as_py()
+        if not isinstance(encoded, dict) or not isinstance(encoded.get("bytes"), (bytes, bytearray)):
+            raise ValueError(f"official {column} frame is not an inline encoded image")
+        with Image.open(io.BytesIO(encoded["bytes"])) as image:
+            return np.asarray(image.convert("RGB"), dtype=np.uint8).copy()
+
+    def __getitem__(self, index: SupportsIndex) -> dict[str, Any]:
+        import pyarrow.parquet as pq
+
+        episode, offset = self._index[index.__index__()]
+        item = self._episodes[episode]
+        length = len(item["actions"])
+        targets = np.arange(offset, offset + self.action_horizon, dtype=np.int64)
+        is_pad = targets >= length
+        action_indices = np.minimum(targets, length - 1)
+        if self.decode_images:
+            key = str(item["file"])
+            table = self._image_tables.get(key)
+            if table is None:
+                table = pq.read_table(item["file"], columns=["image", "wrist_image"])
+                self._image_tables[key] = table
+            image = self._decode_image(table, "image", offset)
+            wrist_image = self._decode_image(table, "wrist_image", offset)
+        else:
+            image = np.zeros((1, 1, 3), dtype=np.uint8)
+            wrist_image = np.zeros((1, 1, 3), dtype=np.uint8)
+        task_index = int(item["task_index"])
+        if self.v3_keys:
+            values = {
+                "observation.images.image": image,
+                "observation.images.wrist_image": wrist_image,
+                "observation.state": item["states"][offset],
+                "action": item["actions"][action_indices],
+                "action_is_pad": is_pad,
+            }
+        else:
+            values = {
+                "image": image,
+                "wrist_image": wrist_image,
+                "state": item["states"][offset],
+                "actions": item["actions"][action_indices],
+                "actions_is_pad": is_pad,
+            }
+        result = {
+            **values,
+            "task_index": task_index,
+            "episode_index": int(episode),
+            "frame_index": int(item["frames"][offset]),
+            "index": int(item["indices"][offset]),
+            "timestamp": float(item["timestamps"][offset]),
+            "task": self.tasks[task_index],
+        }
+        if _audit_metadata_enabled():
+            result[AUDIT_METADATA_KEY] = _canonical_audit_metadata(
+                episode=episode,
+                frame_offset=offset,
+                frame_index=int(item["frames"][offset]),
+                global_index=int(item["indices"][offset]),
+                task_index=task_index,
+                episode_length=len(item["states"]),
+                action_horizon=self.action_horizon,
+            )
+        return result
+
