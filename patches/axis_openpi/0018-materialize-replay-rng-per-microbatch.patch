+def _metric_text(value: Any) -> str:
+    array = np.asarray(value)
+    if array.dtype.kind in "biufc" and array.ndim == 0:
+        return f"{float(array):.4f}"
+    return str(value)
+
+
+def _path_text(path: tuple[Any, ...]) -> str:
+    return "/".join(str(getattr(part, "key", getattr(part, "idx", part))) for part in path)
+
+
+def _group_norm(tree: Any, needle: str) -> jax.Array:
+    leaves = [
+        value
+        for path, value in jax.tree_util.tree_flatten_with_path(tree)[0]
+        if needle in _path_text(path).lower()
+    ]
+    return optax.global_norm(leaves) if leaves else jnp.asarray(0.0, dtype=jnp.float32)
+
+
+def _nonfinite_leaf_count(tree: Any) -> jax.Array:
+    leaves = [value.value if hasattr(value, "value") else value for value in jax.tree_util.tree_leaves(tree)]
+    leaves = [value for value in leaves if hasattr(value, "dtype")]
+    return jnp.asarray(sum(jnp.any(~jnp.isfinite(value)) for value in leaves), dtype=jnp.int32)
+
+
+def _first_nonfinite_path(tree: Any) -> str | None:
+    for path, value in jax.tree_util.tree_flatten_with_path(tree)[0]:
+        value = value.value if hasattr(value, "value") else value
+        if hasattr(value, "dtype") and not np.all(np.isfinite(np.asarray(value))):
+            return _path_text(path)
+    return None
+
+
+def _jsonable(value: Any) -> Any:
+    if isinstance(value, dict):
+        return {str(key): _jsonable(item) for key, item in value.items()}
+    if isinstance(value, (tuple, list)):
+        return [_jsonable(item) for item in value]
+    if isinstance(value, np.ndarray):
+        return value.tolist()
+    if isinstance(value, np.generic):
+        return value.item()
+    return value
+
