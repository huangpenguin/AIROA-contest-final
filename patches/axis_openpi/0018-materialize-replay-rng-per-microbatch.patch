+class AxisSelectedLeRobotDataset(lerobot_dataset.LeRobotDataset):
+    """Fix the pinned v2.1 reader's sparse-episode delta-index lookup."""
+
+    def _get_query_indices(self, idx: int, ep_idx: int):
+        if self.episodes is None:
+            position = ep_idx
+        else:
+            position = self.episodes.index(ep_idx)
+        ep_start = self.episode_data_index["from"][position]
+        ep_end = self.episode_data_index["to"][position]
+        query_indices = {
+            key: [max(ep_start.item(), min(ep_end.item() - 1, idx + delta)) for delta in delta_idx]
+            for key, delta_idx in self.delta_indices.items()
+        }
+        padding = {
+            f"{key}_is_pad": torch.BoolTensor(
+                [(idx + delta < ep_start.item()) | (idx + delta >= ep_end.item()) for delta in delta_idx]
+            )
+            for key, delta_idx in self.delta_indices.items()
+        }
+        return query_indices, padding
