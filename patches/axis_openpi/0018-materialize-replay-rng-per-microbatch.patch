+class WeightedConcatDataset(torch.utils.data.ConcatDataset):
+    """Concatenate local LeRobot sources while retaining source sampling mass."""
+
+    def __init__(
+        self,
+        datasets: Sequence[torch.utils.data.Dataset],
+        source_weights: Sequence[float],
+        frame_weights: Sequence[Sequence[float]] | None = None,
+    ):
+        super().__init__(list(datasets))
+        if len(source_weights) != len(datasets):
+            raise ValueError("local_sampling_weights must match local_repo_roots")
+        if any(weight <= 0 for weight in source_weights):
+            raise ValueError("local_sampling_weights must be positive")
+        total = float(sum(source_weights))
+        if frame_weights is None:
+            per_item = []
+            for dataset, weight in zip(datasets, source_weights, strict=True):
+                per_item.extend([float(weight) / max(1, len(dataset))] * len(dataset))
+        else:
+            if len(frame_weights) != len(datasets):
+                raise ValueError("frame_weights must match datasets")
+            per_item = []
+            for dataset, weights in zip(datasets, frame_weights, strict=True):
+                if len(weights) != len(dataset):
+                    raise ValueError("manifest frame weights must match dataset frame count")
+                if any(float(weight) <= 0 for weight in weights):
+                    raise ValueError("manifest frame weights must be positive")
+                per_item.extend(float(weight) for weight in weights)
+            if not np.isclose(sum(per_item), 1.0, rtol=1e-9, atol=1e-9):
+                raise ValueError(f"manifest frame weights must sum to one, got {sum(per_item)}")
+        self.sample_weights = torch.as_tensor(per_item, dtype=torch.double)
+        self.frame_weights = self.sample_weights
+        self.source_weights = tuple(float(weight) / total for weight in source_weights)
+
