+class AxisPlusV3Dataset(torch.utils.data.Dataset):
+    """Read the locked LeRobot-v3 Plus snapshot without converting its files.
+
+    The pinned OpenPI dependency contains the v2.1 reader for the five IPEC
+    sources.  Plus is v3.0 and stores several episodes per Parquet/video file,
+    so it is read directly here while preserving the same LeRobot sample keys.
+    """
+
+    def __init__(self, root: str, episodes: list[int], action_horizon: int):
+        import pyarrow.parquet as pq
+
+        self.root = pathlib.Path(root)
+        self.action_horizon = int(action_horizon)
+        tasks = pq.read_table(self.root / "meta/tasks.parquet").to_pydict()
+        self.tasks = {
+            int(task_index): str(task)
+            for task_index, task in zip(tasks["task_index"], tasks["task"], strict=True)
+        }
+        selected = {int(episode) for episode in episodes}
+        if not selected:
+            raise ValueError("Plus train manifest selected no episodes")
+        self._episodes: dict[int, dict[str, Any]] = {}
+        for data_file in sorted((self.root / "data").glob("chunk-*/file-*.parquet")):
+            file_match = re.match(r"chunk-(\d+)/file-(\d+)\.parquet$", str(data_file.relative_to(self.root / "data")))
+            if not file_match:
+                continue
+            chunk_index, file_index = (int(value) for value in file_match.groups())
+            table = pq.read_table(
+                data_file,
+                columns=["episode_index", "frame_index", "observation.state", "action", "task_index"],
+            )
+            episode_values = table["episode_index"].to_numpy(zero_copy_only=False)
+            present = selected.intersection(int(value) for value in np.unique(episode_values))
+            if not present:
+                continue
+            frame_values = table["frame_index"].to_numpy(zero_copy_only=False)
+            task_values = table["task_index"].to_numpy(zero_copy_only=False)
+            states = np.asarray(table["observation.state"].to_pylist(), dtype=np.float32)
+            actions = np.asarray(table["action"].to_pylist(), dtype=np.float32)
+            for episode in sorted(present):
+                indices = np.flatnonzero(episode_values == episode)
+                indices = indices[np.argsort(frame_values[indices], kind="stable")]
+                if episode in self._episodes:
+                    raise ValueError(f"Plus episode {episode} appears in multiple data files")
+                self._episodes[episode] = {
+                    "states": states[indices],
+                    "actions": actions[indices],
+                    "frames": frame_values[indices].astype(np.int64, copy=False),
+                    "task_index": int(task_values[indices[0]]),
+                    "chunk_index": chunk_index,
+                    "file_index": file_index,
+                }
+        missing = sorted(selected - set(self._episodes))
+        if missing:
+            raise ValueError(f"Plus train manifest episodes missing from v3 data: {missing[:5]}")
+        self._index = [
+            (episode, frame_offset)
+            for episode in sorted(self._episodes)
+            for frame_offset in range(len(self._episodes[episode]["states"]))
+        ]
+        self._video_containers: dict[str, Any] = {}
+
+    def __getstate__(self):
+        state = self.__dict__.copy()
+        state["_video_containers"] = {}
+        return state
+
+    def __len__(self) -> int:
+        return len(self._index)
+
+    def _decode(self, key: str, item: dict[str, Any], frame_index: int) -> np.ndarray:
+        import av
+
+        path = self.root / "videos" / key / f"chunk-{item['chunk_index']:03d}" / f"file-{item['file_index']:03d}.mp4"
+        container = self._video_containers.get(str(path))
+        if container is None:
+            container = av.open(str(path))
+            self._video_containers[str(path)] = container
+        stream = container.streams.video[0]
+        timestamp = frame_index / 20.0
+        seek_pts = int(timestamp / float(stream.time_base)) if stream.time_base else frame_index
+        container.seek(max(0, seek_pts), stream=stream, backward=True)
+        candidate = None
+        for frame in container.decode(video=0):
+            if frame.pts is None:
+                continue
+            candidate = frame
+            if frame.time >= timestamp - 1e-4:
+                break
+        if candidate is None:
+            raise RuntimeError(f"failed to decode {path} at frame {frame_index}")
+        return candidate.to_ndarray(format="rgb24")
+
+    def __getitem__(self, index: SupportsIndex) -> dict[str, Any]:
+        episode, frame_offset = self._index[index.__index__()]
+        item = self._episodes[episode]
+        frame_index = int(item["frames"][frame_offset])
+        action_indices = [min(frame_offset + offset, len(item["actions"]) - 1) for offset in range(self.action_horizon)]
+        result = {
+            # Match the pinned IPEC LeRobot key names; the logical contract
+            # still calls these front and wrist cameras in the catalog.
+            "observation.images.image": self._decode("observation.images.front", item, frame_index),
+            "observation.images.wrist_image": self._decode("observation.images.wrist", item, frame_index),
+            "observation.state": item["states"][frame_offset],
+            "action": item["actions"][action_indices],
+            "task_index": item["task_index"],
+            "episode_index": episode,
+            "frame_index": frame_index,
+            "timestamp": frame_index / 20.0,
+        }
+        if _audit_metadata_enabled():
+            result[AUDIT_METADATA_KEY] = _canonical_audit_metadata(
+                episode=episode,
+                frame_offset=frame_offset,
+                frame_index=frame_index,
+                global_index=int(index),
+                task_index=item["task_index"],
+                episode_length=len(item["states"]),
+                action_horizon=self.action_horizon,
+            )
+        return result
+
+    def close(self) -> None:
+        for container in self._video_containers.values():
+            container.close()
+        self._video_containers.clear()
+
