+"""Auditable parameter and precision contracts for the Axis LoRA arms."""
+
+from __future__ import annotations
+
+import dataclasses
+from collections.abc import Iterable
+from typing import Any, Literal
+
+import flax.nnx as nnx
+import jax
+import jax.numpy as jnp
+
+ArmName = Literal[
+    "L1_action_lora",
+    "L2_action_lora_heads",
+    "L3_dual_lora_heads",
+    "L4_dual_lora_heads_32d",
+]
+
+ARM_NAMES: tuple[ArmName, ...] = (
+    "L1_action_lora",
+    "L2_action_lora_heads",
+    "L3_dual_lora_heads",
+    "L4_dual_lora_heads_32d",
+)
+
+
+@dataclasses.dataclass(frozen=True)
+class ArmScope:
+    name: ArmName
+    action_expert_lora: bool
+    paligemma_lora: bool
+    action_heads: bool
+
+
+ARM_SCOPES: dict[ArmName, ArmScope] = {
+    "L1_action_lora": ArmScope("L1_action_lora", True, False, False),
+    "L2_action_lora_heads": ArmScope("L2_action_lora_heads", True, False, True),
+    "L3_dual_lora_heads": ArmScope("L3_dual_lora_heads", True, True, True),
+    "L4_dual_lora_heads_32d": ArmScope("L4_dual_lora_heads_32d", True, True, True),
+}
+
+LORA_LEAF_NAMES = frozenset(
+    {
+        "lora_a",
+        "lora_b",
+        "gating_einsum_lora_a",
+        "gating_einsum_lora_b",
+        "linear_lora_a",
+        "linear_lora_b",
+    }
+)
+ACTION_HEAD_NAMES = frozenset({"action_in_proj", "action_out_proj", "time_mlp_in", "time_mlp_out"})
+ACTION_EXPERT_COMPONENTS = frozenset(
+    {"mlp_1", "q_einsum_1", "kv_einsum_1", "attn_vec_einsum_1"}
+)
+
+
+def path_text(path: Iterable[Any]) -> str:
+    return "/".join(str(getattr(part, "key", getattr(part, "idx", part))) for part in path)
+
+
+def path_parts(path: Iterable[Any]) -> tuple[str, ...]:
+    return tuple(str(getattr(part, "key", getattr(part, "idx", part))) for part in path)
+
+
+def _is_lora_leaf(parts: tuple[str, ...]) -> bool:
+    return parts[-1] in LORA_LEAF_NAMES
+
+
+def _is_action_expert_lora(parts: tuple[str, ...]) -> bool:
+    # Gemma names the second expert's MLP branch ``mlp_1`` and its attention
+    # projections ``*_einsum_1``.  Matching complete components avoids
+    # confusing them with the first expert or with layer indices.
+    return _is_lora_leaf(parts) and any(part in ACTION_EXPERT_COMPONENTS for part in parts)
+
+
+def _is_paligemma_lora(parts: tuple[str, ...]) -> bool:
+    return _is_lora_leaf(parts) and any(part in {"attn", "mlp"} for part in parts)
+
+
+def _is_action_head(parts: tuple[str, ...]) -> bool:
+    return any(part in ACTION_HEAD_NAMES for part in parts)
+
+
+def is_declared_trainable(path: Iterable[Any], arm: ArmName | str) -> bool:
+    """Return whether one concrete parameter leaf is trainable for ``arm``."""
+    if arm not in ARM_SCOPES:
+        raise ValueError(f"unknown Axis LoRA arm: {arm}")
+    scope = ARM_SCOPES[arm]
+    parts = path_parts(path)
+    if _is_action_expert_lora(parts):
+        return scope.action_expert_lora
+    if _is_paligemma_lora(parts):
+        return scope.paligemma_lora
+    if _is_action_head(parts):
+        return scope.action_heads
+    return False
+
+
+def make_freeze_filter(arm: ArmName | str):
+    """Build an NNX freeze filter from the exact leaf classifier."""
+    if arm not in ARM_SCOPES:
+        raise ValueError(f"unknown Axis LoRA arm: {arm}")
+
+    def freeze(path, _param) -> bool:
+        return not is_declared_trainable(path, arm)
+
+    return freeze
+
+
+def classify_path(path: Iterable[Any]) -> str:
+    parts = path_parts(path)
+    if _is_action_expert_lora(parts):
+        return "action_expert_lora"
+    if _is_paligemma_lora(parts):
+        return "paligemma_lora"
+    if _is_action_head(parts):
+        return "action_head"
+    if any(part in {"img", "vision", "vision_tower"} for part in parts):
+        return "vision_or_image"
+    return "frozen_base"
+
+
+def scope_manifest(state: Any, arm: ArmName | str) -> dict[str, Any]:
+    """Summarize every parameter leaf and assert exact trainable scope."""
+    entries: list[dict[str, Any]] = []
+    pure_state = state.to_pure_dict() if hasattr(state, "to_pure_dict") else state
+    for path, value in jax.tree_util.tree_flatten_with_path(pure_state)[0]:
+        if not hasattr(value, "shape"):
+            continue
+        parts = path_parts(path)
+        declared = is_declared_trainable(parts, arm)
+        entries.append(
+            {
+                "path": "/".join(parts),
+                "shape": list(value.shape),
+                "dtype": str(value.dtype),
+                "numel": int(value.size),
+                "bytes": int(value.size * jnp.dtype(value.dtype).itemsize),
+                "group": classify_path(parts),
+                "trainable": declared,
+            }
+        )
+    entries.sort(key=lambda item: item["path"])
+    trainable = [item for item in entries if item["trainable"]]
+    frozen = [item for item in entries if not item["trainable"]]
+    return {
+        "arm": arm,
+        "parameters": entries,
+        "trainable": trainable,
+        "frozen": frozen,
+        "trainable_leaf_count": len(trainable),
+        "frozen_leaf_count": len(frozen),
+        "trainable_numel": sum(item["numel"] for item in trainable),
+        "frozen_numel": sum(item["numel"] for item in frozen),
+        "trainable_bytes_fp32": sum(item["numel"] * 4 for item in trainable),
+        "all_numel": sum(item["numel"] for item in entries),
+        "trainable_parameter_fraction": (
+            sum(item["numel"] for item in trainable) / max(1, sum(item["numel"] for item in entries))
+        ),
+    }
+
+
+def assert_exact_scope(state: Any, arm: ArmName | str) -> dict[str, Any]:
+    manifest = scope_manifest(state, arm)
+    for entry in manifest["parameters"]:
+        if entry["trainable"] and entry["group"] == "vision_or_image":
+            raise AssertionError(f"vision parameter declared trainable: {entry['path']}")
+    if manifest["trainable_leaf_count"] == 0:
+        raise AssertionError(f"no trainable leaves for {arm}")
+    return manifest
+
+
+def assert_no_bfloat16(state: Any, *, context: str = "state") -> None:
+    pure_state = state.to_pure_dict() if hasattr(state, "to_pure_dict") else state
+    for path, value in jax.tree_util.tree_flatten_with_path(pure_state)[0]:
+        if hasattr(value, "dtype") and jnp.dtype(value.dtype) == jnp.dtype(jnp.bfloat16):
+            raise ValueError(f"BF16 is forbidden in V100 Axis LoRA runs: {context} {path_text(path)}")
