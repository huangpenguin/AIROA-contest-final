+class _FixedReplayDataLoader:
+    """Cycle a host-written, transformed sample fixture for NaN matrix runs."""
+
+    def __init__(self, data_config, replay_path: str | Path, sharding: jax.sharding.Sharding):
+        self._data_config = data_config
+        self._sharding = sharding
+        self._replay_path = Path(replay_path)
+        self._archive = np.load(self._replay_path, allow_pickle=False)
+        self._manifest = json.loads((self._replay_path.parent / "fixed_replay_manifest.json").read_text())
+        replay_sha256 = hashlib.sha256(self._replay_path.read_bytes()).hexdigest()
+        if replay_sha256 != self._manifest.get("replay_sha256"):
+            raise ValueError(
+                f"fixed replay sha256 mismatch: {replay_sha256} != {self._manifest.get('replay_sha256')}"
+            )
+        self._sample_count = int(self._manifest["sample_count"])
+        if self._sample_count != 64:
+            raise ValueError(f"fixed replay must contain exactly 64 samples, got {self._sample_count}")
+        self._batch_size = int(os.environ.get("AXIS_PI05_FIXED_REPLAY_BATCH_SIZE", str(jax.device_count())))
+        if self._batch_size <= 0 or self._sample_count % self._batch_size != 0:
+            raise ValueError("fixed replay sample count must be divisible by the fixed replay batch size")
+
+    def data_config(self):
+        return self._data_config
+
+    def __iter__(self):
+        batch_size = self._batch_size
+        while True:
+            for start in range(0, self._sample_count, batch_size):
+                end = start + batch_size
+                def take(name: str):
+                    # Do not expose an np.load view to JAX device placement.  On
+                    # the V100 multi-device path the asynchronous transfer may
+                    # otherwise alias the archive-backed host buffer; later
+                    # model work can then corrupt a future replay slice.
+                    return np.array(self._archive[name][start:end], copy=True)
+
+                batch_dict = {
+                    "image": {
+                        key: take(f"observation__image__{key}")
+                        for key in ("base_0_rgb", "left_wrist_0_rgb", "right_wrist_0_rgb")
+                    },
+                    "image_mask": {
+                        key: take(f"observation__image_mask__{key}")
+                        for key in ("base_0_rgb", "left_wrist_0_rgb", "right_wrist_0_rgb")
+                    },
+                    "state": take("observation__state"),
+                    "action_is_pad": take("observation__action_is_pad"),
+                    "tokenized_prompt": take("observation__tokenized_prompt"),
+                    "tokenized_prompt_mask": take("observation__tokenized_prompt_mask"),
+                }
+                observation = _model.Observation.from_dict(batch_dict)
+                actions = take("actions")
+                model_batch = jax.tree.map(
+                    lambda value: jax.make_array_from_process_local_data(self._sharding, value),
+                    (observation, actions),
+                )
+                rows = self._manifest["metadata"][start:end]
+                metadata = {
+                    key: np.asarray([row[key] for row in rows])
+                    for key in rows[0]
+                }
+                overrides = {
+                    "noise": take("rng__noise"),
+                    "time": take("rng__time"),
+                }
+                yield (*model_batch, metadata, overrides)
+
