+def _validate_official_sampling_jsonl(
+    path: str | os.PathLike[str], *, expected_count: int | None = None, expected_revision: str | None = None
+) -> int:
+    """Validate the Phase 1 frame catalog without turning it into weights."""
+    import json
+
+    count = 0
+    with pathlib.Path(path).open(encoding="utf-8") as handle:
+        for count, line in enumerate(handle, start=1):
+            row = json.loads(line)
+            if row.get("source_repo") != "physical-intelligence/libero":
+                raise ValueError(f"official sampling manifest contains non-canonical source: {row.get('source_repo')}")
+            if row.get("fps") != 10 or row.get("action_horizon") != 10:
+                raise ValueError("official sampling manifest is not native 10 Hz horizon-10")
+            if row.get("sampler") != "official_native_sequential_frame_once" or not row.get("revision"):
+                raise ValueError("official sampling manifest sampler/revision contract mismatch")
+            if expected_revision is not None and row["revision"] != expected_revision:
+                raise ValueError(f"official sampling manifest revision mismatch: {row['revision']} != {expected_revision}")
+            if row.get("global_index") != count - 1:
+                raise ValueError("official sampling manifest global_index is not sequential")
+    if expected_count is not None and count != expected_count:
+        raise ValueError(f"official sampling manifest frame count mismatch: {count} != {expected_count}")
+    return count
+
