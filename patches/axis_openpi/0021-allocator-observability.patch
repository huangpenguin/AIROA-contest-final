+def _record_executable_memory_analysis(jitted: Any, phase: str, args: tuple[Any, ...]) -> None:
+    """Record XLA executable memory analysis when the installed JAX exposes it.
+
+    The lower/compile probe is diagnostic only and is never allowed to change
+    training control flow.  It is called after the normal first invocation so
+    the regular cached executable remains the one used for the update.
+    """
+    output = os.environ.get("AXIS_PI05_ALLOCATOR_STATS_PATH")
+    if not output or os.environ.get("AXIS_PI05_EXECUTABLE_MEMORY_ANALYSIS", "0") != "1":
+        return
+    result: dict[str, Any] = {"available": False}
+    lower = getattr(jitted, "lower", None)
+    if lower is None:
+        result["reason"] = "jitted_callable_has_no_lower"
+    else:
+        try:
+            compiled = lower(*args).compile()
+            method = getattr(compiled, "memory_analysis", None)
+            if method is None:
+                result["reason"] = "compiled_executable_has_no_memory_analysis"
+            else:
+                analysis = method()
+                if dataclasses.is_dataclass(analysis):
+                    result.update({"available": True, **_jsonable(dataclasses.asdict(analysis))})
+                else:
+                    fields = (
+                        "argument_size_in_bytes",
+                        "output_size_in_bytes",
+                        "alias_size_in_bytes",
+                        "temp_size_in_bytes",
+                        "generated_code_size_in_bytes",
+                    )
+                    result.update(
+                        {
+                            "available": True,
+                            **{field: _jsonable(getattr(analysis, field)) for field in fields if hasattr(analysis, field)},
+                        }
+                    )
+        except Exception as exc:  # pragma: no cover - backend/compiler-specific
+            result.update({"reason": f"{type(exc).__name__}: {exc}"})
+    _record_allocator_stats("executable_memory_analysis", executable_phase=phase, analysis=result)
+
+
+def _write_restore_validation(train_state: Any) -> None:
+    """Write small, deterministic restore sentinels requested by recovery runs."""
+    output = os.environ.get("AXIS_PI05_RESTORE_VALIDATION_PATH")
+    if not output:
+        return
+    expected = json.loads(os.environ.get("AXIS_PI05_EXPECTED_PARAMS_SENTINELS", "[]"))
+    flat = traverse_util.flatten_dict(train_state.params.to_pure_dict(), sep="/")
+    sentinels = []
+    for item in expected:
+        path = str(item["path"])
+        if path not in flat:
+            raise ValueError(f"restore sentinel path missing: {path}")
+        array = np.ascontiguousarray(np.asarray(jax.device_get(flat[path])))
+        actual = {
+            "path": path,
+            "shape": list(array.shape),
+            "dtype": str(array.dtype),
+            "sha256": hashlib.sha256(array.tobytes()).hexdigest(),
+        }
+        actual["exact"] = bool(
+            actual["shape"] == item.get("shape")
+            and actual["dtype"] == item.get("dtype")
+            and actual["sha256"] == item.get("sha256")
+        )
+        sentinels.append(actual)
+    finite = True
+    finite_sample_elements = 0
+    for value in jax.tree_util.tree_leaves(train_state.opt_state):
+        if not hasattr(value, "dtype"):
+            continue
+        # A restore check must not materialize the multi-gigabyte Adam tree on
+        # the host.  Check the first small leaves; Orbax has already enforced
+        # the complete shape/dtype contract for the full tree.
+        if int(np.prod(value.shape)) > 1_000_000:
+            continue
+        host_value = np.asarray(jax.device_get(value))
+        finite_sample_elements += int(host_value.size)
+        if not np.all(np.isfinite(host_value)):
+            finite = False
+            break
+    rng = train_state.rng
+    rng_fingerprint = None
+    if rng is not None:
+        rng_data = np.ascontiguousarray(np.asarray(jax.device_get(jax.random.key_data(rng))))
+        rng_fingerprint = {
+            "dtype": str(rng_data.dtype),
+            "shape": list(rng_data.shape),
+            "sha256": hashlib.sha256(rng_data.tobytes()).hexdigest(),
+        }
+    report = {
+        "schema_version": 1,
+        "status": "passed" if int(train_state.step) >= 0 and all(item["exact"] for item in sentinels) and finite else "failed",
+        "step": int(train_state.step),
+        "params_sentinels": sentinels,
+        "optimizer_finite": finite,
+        "optimizer_finite_sample_elements": finite_sample_elements,
+        "ema_params_present": train_state.ema_params is not None,
+        "rng": rng_fingerprint,
+        "scheduler_and_optimizer_restored": True,
+    }
+    Path(output).parent.mkdir(parents=True, exist_ok=True)
+    Path(output).write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+
