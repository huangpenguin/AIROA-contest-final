+def _allocator_environment() -> dict[str, Any]:
+    """Return the allocator contract without exposing unrelated environment."""
+    return {key: os.environ.get(key) for key in _ALLOCATOR_ENV_KEYS if key in os.environ}
+
+
+def _record_allocator_stats(phase: str, **extra: Any) -> None:
+    """Append host/JAX allocator state when the recovery runner requests it."""
+    output = os.environ.get("AXIS_PI05_ALLOCATOR_STATS_PATH")
+    if not output:
+        return
+    devices = []
+    for device in jax.local_devices():
+        row: dict[str, Any] = {
+            "id": int(device.id) if isinstance(device.id, (int, np.integer)) else str(device.id),
+            "platform": device.platform,
+            "memory_stats_available": False,
+        }
+        try:
+            stats = device.memory_stats()
+        except Exception as exc:  # pragma: no cover - backend-specific
+            row["memory_stats_error"] = f"{type(exc).__name__}: {exc}"
+        else:
+            if stats is not None:
+                row["memory_stats_available"] = True
+                row["memory_stats"] = _jsonable(stats)
+        devices.append(row)
+    _append_audit_trace(
+        Path(output),
+        {
+            "schema_version": 1,
+            "timestamp": time.time(),
+            "pid": os.getpid(),
+            "phase": phase,
+            "allocator_environment": _allocator_environment(),
+            "devices": devices,
+            **extra,
+        },
+    )
+
