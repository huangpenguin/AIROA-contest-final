+def _materialize_metric_scalars(info: dict[str, Any]) -> dict[str, Any]:
+    """Copy scalar metrics to host values so device metric arrays do not span steps."""
+    result: dict[str, Any] = {}
+    for key, value in info.items():
+        host_value = np.asarray(jax.device_get(value))
+        result[key] = host_value.item() if host_value.ndim == 0 else host_value.copy()
+    return result
